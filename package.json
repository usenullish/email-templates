{
  "name": "react-email-starter",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "build": "email build",
    "dev": "email dev",
    "export": "./export.sh && node export.subjects.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=development playwright test",
    "test:snapshots": "NODE_ENV=development playwright test --update-snapshots --reporter=list",
    "test:ci": "playwright test --reporter=html",
    "test:ci:snapshots": "playwright test --update-snapshots --reporter=html"
  },
  "dependencies": {
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "6.11.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@react-email/ui": "6.11.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
